{
  "info": {
    "_postman_id": "2c49226c-cdfb-4c57-9f08-08e91b4bec51",
    "name": "Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "equipmentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "response": []
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Create equipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('equipmentId', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine A\",\n  \"serialNumber\": \"TRB-001\",\n  \"type\": \"turbine\",\n  \"status\": \"fault\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/equipment"
          },
          "response": []
        },
        {
          "name": "Get equipment list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment"
          },
          "response": []
        },
        {
          "name": "Get equipment by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "response": []
        },
        {
          "name": "Update equipment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine A (updated)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "response": []
        },
        {
          "name": "Filter by status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?status=fault"
          },
          "response": []
        },
        {
          "name": "Filter by type",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?type=turbine"
          },
          "response": []
        },
        {
          "name": "Sort by name",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?sort=name"
          },
          "response": []
        },
        {
          "name": "Pagination",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?page=2&limit=10"
          },
          "response": []
        },
        {
          "name": "Duplicate serial number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine B\",\n  \"serialNumber\": \"TRB-001\",\n  \"type\": \"turbine\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/equipment"
          },
          "response": []
        },
        {
          "name": "Delete equipment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "response": []
        },
        {
          "name": "Get missing equipment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/00000000-0000-0000-0000-000000000000"
          },
          "response": []
        }
      ]
    }
  ]
}
